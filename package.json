{
  "name": "lanyard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler d1 migrations apply lanyard_db --local && wrangler dev --port 8787",
    "build": "vite build",
    "preview": "vite preview",
    "db:local": "wrangler d1 migrations apply lanyard_db --local",
    "db:remote": "wrangler d1 migrations apply lanyard_db --remote --config wrangler.production.toml",
    "deploy": "npm run build && wrangler deploy --config wrangler.production.toml",
    "export:prod": "node scripts/export-kv.mjs",
    "export:local": "node scripts/export-kv.mjs --local",
    "import:local": "node scripts/import-v2.mjs --local",
    "import:remote": "node scripts/import-v2.mjs --remote",
    "smoke:events": "node scripts/smoke-events.mjs",
    "migrate:kv": "node scripts/migrate-kv.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.13.13",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "pptxgenjs": "^4.0.1",
    "vite": "^8.3.0",
    "wrangler": "^4.20.5"
  },
  "allowScripts": {
    "workerd@1.20261012.1": true
  }
}
