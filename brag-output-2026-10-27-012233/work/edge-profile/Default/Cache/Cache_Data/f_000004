<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Lanyard for hosts</title>
<link rel="stylesheet" href="main.css">
<style>
  html, body { margin: 0; width: 1920px; height: 1080px; overflow: hidden; background: #f4f1ea; }
  body { min-height: 0; }
  #stage { position: relative; width: 1920px; height: 1080px; overflow: hidden; background: var(--paper); }
  .abs { position: absolute; }
  .scene { position: absolute; inset: 0; opacity: 0; }
  .center-x { left: 0; right: 0; text-align: center; }
  .big { font-weight: 700; letter-spacing: -0.025em; line-height: 1.08; color: var(--ink); }
  .strap-band { position: absolute; left: 0; top: 0; height: 14px; width: 1920px; background: var(--strap); transform-origin: left center; }

  /* pain cards */
  .pain { position: absolute; left: 200px; width: 1520px; height: 170px; display: flex; align-items: center; gap: 40px; padding: 0 48px;
          background: var(--paper-raised); border: 1.5px solid var(--ink); border-radius: 10px; box-shadow: var(--shadow-2); }
  .pain .x { width: 76px; height: 76px; border-radius: 50%; border: 3px solid var(--strap); color: var(--strap); display: flex; align-items: center; justify-content: center; flex: none; }
  .pain strong { font-size: 58px; letter-spacing: -0.02em; display: block; line-height: 1.05; }
  .pain span.muted { font-size: 30px; display: block; margin-top: 6px; }

  /* steps column */
  .steps-col { position: absolute; left: 150px; top: 290px; width: 600px; }
  .steps-col .s { display: flex; gap: 22px; align-items: baseline; margin-bottom: 40px; }
  .steps-col .num { font-weight: 700; color: var(--strap); font-variant-numeric: tabular-nums; font-size: 34px; width: 50px; flex: none; }
  .steps-col strong { display: block; font-size: 50px; line-height: 1.05; letter-spacing: -0.02em; }
  .steps-col .muted { display: block; font-size: 26px; margin-top: 8px; line-height: 1.3; }
  .top-word { position: absolute; left: 150px; top: 88px; display: flex; align-items: baseline; gap: 18px; }

  /* browser window */
  .browser { position: absolute; left: 0; top: 0; width: 1040px; height: 800px; border: 1.5px solid var(--ink); border-radius: 12px; overflow: hidden; background: var(--paper); box-shadow: 0 2px 4px rgba(27,26,23,.1), 0 34px 70px -20px rgba(27,26,23,.45); }
  .chrome { height: 48px; border-bottom: 1.5px solid var(--ink); background: var(--paper-raised); display: flex; align-items: center; gap: 8px; padding: 0 18px; }
  .chrome i { width: 12px; height: 12px; border-radius: 50%; background: var(--rule); display: block; }
  .chrome .url { margin-left: 18px; flex: 1; height: 30px; border: 1px solid var(--rule); border-radius: 15px; display: flex; align-items: center; padding: 0 16px; font-size: 14px; color: var(--graphite); }
  .bview { position: absolute; left: 0; right: 0; top: 50px; bottom: 0; }
  .bview .wide-col { padding: 22px 30px; max-width: none; zoom: 1.3; }
  .event-live-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 18px; }
  .poster-qr { border: var(--border-ink); border-radius: var(--radius); background: #fff; padding: 16px; display: flex; justify-content: center; }
  .poster-qr img { width: 280px; height: 280px; display: block; }
  .stat { display: flex; align-items: baseline; justify-content: space-between; border-bottom: var(--border); padding-bottom: 10px; }
  .stat:last-of-type { border-bottom: none; }
  .stat-n { font-size: 40px; font-weight: 700; }
  .report-stats { display:grid; grid-template-columns: repeat(3,1fr); gap:12px; text-align:center; }
  .report-stats div { border:var(--border); border-radius:var(--radius); padding:14px; display:flex; flex-direction:column; gap:4px; }
  .report-stats strong { font-size:32px; }
  .report-block { display:flex; flex-direction:column; gap:8px; }
  .glow { position: absolute; border: 3px solid var(--strap); border-radius: 10px; pointer-events: none; opacity: 0; }

  .flyer { position: absolute; left: 0; top: 0; width: 72px; height: 72px; border: 1.5px solid var(--ink); border-radius: 8px; overflow: hidden; box-shadow: var(--shadow-2); opacity: 0; z-index: 50; }
  .flyer svg { width: 100%; height: 100%; display: block; }
  .ping { position: absolute; left: 0; top: 0; display: flex; align-items: center; gap: 8px; padding: 6px 14px 6px 6px; background: var(--paper-raised); border: 1.5px solid var(--ink); border-radius: 999px; box-shadow: var(--shadow-2); font-weight: 700; font-size: 17px; opacity: 0; z-index: 50; white-space: nowrap; }
  .ping .duo { display: flex; }
  .ping .duo span { width: 34px; height: 34px; border-radius: 50%; overflow: hidden; border: 1.5px solid var(--paper-raised); display: block; }
  .ping .duo span + span { margin-left: -10px; }
  .ping .duo svg { width: 100%; height: 100%; display: block; }
  .tap { position: absolute; width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 50%; background: rgba(27,26,23,.22); border: 2px solid rgba(255,255,255,.85); box-shadow: 0 4px 14px rgba(0,0,0,.25); pointer-events: none; opacity: 0; z-index: 90; }
</style>
</head>
<body>
<div id="stage">

  <!-- S1 hook: the sign-in sheet -->
  <div class="scene" id="s1">
    <svg id="sheet" class="abs" style="left:250px;top:110px" width="620" height="860" viewBox="0 0 620 860"></svg>
    <div class="abs big" id="h1a" style="left:1000px;top:360px;font-size:104px;width:860px">The event's over.</div>
    <div class="abs big" id="h1b" style="left:1000px;top:520px;font-size:60px;width:860px;color:var(--graphite)">All you've got is this.</div>
  </div>

  <!-- S2 problem -->
  <div class="scene" id="s2">
    <div class="pain" id="pa1" style="top:190px"><span class="x"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></span><div><strong>Who actually came?</strong><span class="muted">Half the sign-in sheet is unreadable.</span></div></div>
    <div class="pain" id="pa2" style="top:455px"><span class="x"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></span><div><strong>Who met who?</strong><span class="muted">No way to tell if the networking worked.</span></div></div>
    <div class="pain" id="pa3" style="top:720px"><span class="x"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></span><div><strong>What do you show sponsors?</strong><span class="muted">A crowd photo and a guess.</span></div></div>
  </div>

  <!-- S3 reveal -->
  <div class="scene" id="s3">
    <div class="abs center-x" id="revEyebrow" style="top:270px"><span class="label" style="font-size:22px;color:var(--strap)">For hosts</span></div>
    <div class="abs center-x" id="revWord" style="top:320px"><span class="wordmark" style="font-size:210px;letter-spacing:-0.045em">lanyard<b>.</b></span></div>
    <div class="abs center-x big" id="revTag" style="top:640px;font-size:62px">Know who actually came — and who they met.</div>
  </div>

  <!-- S4–S6 product -->
  <div class="scene" id="sP">
    <div class="top-word"><span class="wordmark" style="font-size:40px">lanyard<b>.</b></span><span class="label" style="font-size:15px">For hosts</span></div>
    <div class="steps-col">
      <div class="s" id="st1"><span class="num">01</span><div><strong>Display one QR.</strong><span class="muted">Attendees scan to check in — no app, no typing.</span></div></div>
      <div class="s" id="st2"><span class="num">02</span><div><strong>Watch the room live.</strong><span class="muted">Check-in count and connections as they happen.</span></div></div>
      <div class="s" id="st3"><span class="num">03</span><div><strong>Get the report.</strong><span class="muted">Courses, topics and sponsor opt-ins — aggregate only.</span></div></div>
    </div>

    <div class="browser" id="browser">
      <div class="chrome"><i></i><i></i><i></i><div class="url">Host portal · Spring Careers Fair</div></div>

      <div class="bview" id="liveView">
        <div class="wide-col stack-3">
          <div class="spread">
            <div>
              <span class="label tnum">Check-in code K7QF</span>
              <h1>Spring Careers Fair</h1>
              <p class="sub muted" style="margin-top:4px">Main Hall</p>
            </div>
            <span class="btn" id="reportBtn" style="width:auto">Report</span>
          </div>
          <div class="event-live-grid">
            <div class="panel stack" style="text-align:center" id="qrPanel">
              <span class="label">Scan to check in</span>
              <div class="poster-qr" id="posterQr"><img src="qr.svg" alt=""></div>
              <div class="code-glyph tnum" style="font-size:26px;letter-spacing:.3em;font-weight:700">K7QF</div>
              <span class="btn">Print / full-screen</span>
            </div>
            <div class="panel stack-2" id="statPanel">
              <div class="stat"><span class="stat-n tnum" id="nIn">0</span><span class="label">Checked in</span></div>
              <div class="stat" id="connRow"><span class="stat-n tnum" id="nConn">0</span><span class="label">Connections</span></div>
              <div class="stat"><span class="stat-n tnum" id="nSelf">0</span><span class="label">Selfies</span></div>
              <p class="small muted">Aggregate only. You never see who connected with whom.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="bview" id="reportView" style="opacity:0">
        <div class="wide-col">
          <div class="panel stack-3">
            <div class="spread"><h2>Post-event report</h2><span class="small muted">Spring Careers Fair · Main Hall</span></div>
            <div class="report-stats" id="rb0">
              <div><strong class="tnum">148</strong><span class="label">Check-ins</span></div>
              <div><strong class="tnum">212</strong><span class="label">Connections</span></div>
              <div><strong class="tnum">96</strong><span class="label">Selfies</span></div>
            </div>
            <p class="notice small" id="rb1">Aggregate only. Hosts never see who connected with whom.</p>
            <div class="report-block" id="rb2"><span class="label">Courses</span><div class="chip-row"><span class="chip muted">Mechanical Engineering · 42</span><span class="chip muted">Computer Science · 31</span><span class="chip muted">Economics · 19</span><span class="chip muted">Physics · 12</span></div></div>
            <div class="report-block" id="rb3"><span class="label">Come-to-me-for topics</span><div class="chip-row"><span class="chip muted">internships · 38</span><span class="chip muted">CV reviews · 22</span><span class="chip muted">CAD · 15</span><span class="chip muted">startups · 11</span></div></div>
            <div class="report-block" id="rb4"><span class="label">What are you looking for?</span><div class="chip-row"><span class="chip muted">Internship · 54</span><span class="chip muted">Graduate job · 30</span><span class="chip muted">Just browsing · 17</span></div></div>
            <div class="report-block" id="rb5"><span class="label">Sponsor opt-ins</span><div class="chip-row"><span class="chip">Northbeam · 27</span><span class="chip">Halden Labs · 14</span></div></div>
          </div>
        </div>
      </div>
    </div>
    <div class="glow" id="glow"></div>
    <div id="flyers"></div>
    <div id="pings"></div>
    <div class="tap" id="tap"></div>
  </div>

  <!-- S7 outro -->
  <div class="scene" id="s7">
    <div class="abs center-x" id="oEyebrow" style="top:250px"><span class="label" style="font-size:22px;color:var(--strap)">For hosts</span></div>
    <div class="abs center-x" id="oWord" style="top:290px"><span class="wordmark" style="font-size:190px;letter-spacing:-0.045em">lanyard<b>.</b></span></div>
    <div class="abs center-x big" id="oTag" style="top:575px;font-size:60px">First 3 society events on us.</div>
    <div class="abs center-x" id="oBtn" style="top:690px"><span class="btn btn-primary" style="width:auto;font-size:28px;padding:22px 44px">Open the host portal</span></div>
    <div class="abs center-x" id="oSub" style="top:812px;font-size:24px;color:var(--graphite);font-weight:700">Attendees always use Lanyard for free</div>
  </div>

  <div class="strap-band" id="band"></div>
</div>

<script>
// ---------- fictional, drawn people ----------
const SKIN = ['#f1c7a5','#e0ac83','#c68a5e','#8d5a3b','#5e3a24','#f6d5bd','#d9a27c'];
const HAIR = ['#1b1a17','#3b2a1e','#6b4a2e','#b98544','#d9c08a','#7a3b22','#2a2420'];
const BG   = ['#e9d9c4','#d8e1d6','#dcd8ea','#f0d6cc','#d6e4ea','#ece4c9','#e4d3d9'];
const SHIRT= ['#2b3138','#d9502b','#4d6b5a','#5a5f8a','#8a5a3b','#1b1a17','#c9b28a','#6f8fa6'];
const STYLES = ['curly','side','long','short','bob','buzz','bun'];
function figure(p) {
  const s = SKIN[p.skin], h = HAIR[p.hair], sh = SHIRT[p.shirt];
  let back = '', front = '';
  if (p.style === 'long') { back = `<path d="M28 44 C26 22 74 22 72 44 L74 80 L26 80Z" fill="${h}"/>`; front = `<path d="M32 44 C30 22 70 22 68 44 C64 32 46 28 32 44Z" fill="${h}"/>`; }
  if (p.style === 'short') front = `<path d="M32 43 C31 23 69 23 68 43 C66 34 56 31 50 31 C43 31 35 34 32 43Z" fill="${h}"/>`;
  if (p.style === 'side') front = `<path d="M32 44 C30 22 70 20 68 42 C60 34 50 34 42 30 C38 34 35 38 32 44Z" fill="${h}"/>`;
  if (p.style === 'buzz') front = `<path d="M33 41 C33 24 67 24 67 41 C63 33 37 33 33 41Z" fill="${h}" opacity=".85"/>`;
  if (p.style === 'bob') { back = `<path d="M29 46 C27 22 73 22 71 46 L71 60 L29 60Z" fill="${h}"/>`; front = `<path d="M31 46 C31 26 69 24 69 46 C66 36 56 33 48 33 C40 33 34 38 31 46Z" fill="${h}"/>`; }
  if (p.style === 'bun') { back = `<circle cx="50" cy="19" r="9" fill="${h}"/>`; front = `<path d="M32 43 C31 23 69 23 68 43 C64 33 36 33 32 43Z" fill="${h}"/>`; }
  if (p.style === 'curly') { back = [[34,32],[40,25],[50,22],[60,25],[66,32],[69,41],[31,41],[30,50],[70,50]].map(([x,y])=>`<circle cx="${x}" cy="${y}" r="8.5" fill="${h}"/>`).join(''); }
  const glasses = p.glasses ? `<g fill="none" stroke="#1b1a17" stroke-width="1.6"><circle cx="43.5" cy="46" r="4.6"/><circle cx="56.5" cy="46" r="4.6"/><path d="M48 46h4"/></g>` : '';
  return `<rect width="100" height="100" fill="${BG[p.bg]}"/>${back}
    <path d="M12 100 C12 78 30 70 50 70 C70 70 88 78 88 100Z" fill="${sh}"/>
    <path d="M43 60 h14 v12 c-4 4 -10 4 -14 0z" fill="${s}" style="filter:brightness(.9)"/>
    <ellipse cx="50" cy="45" rx="17" ry="20" fill="${s}"/>${front}
    <circle cx="43.5" cy="46.5" r="1.7" fill="#1b1a17"/><circle cx="56.5" cy="46.5" r="1.7" fill="#1b1a17"/>
    <path d="M44.5 54.5 Q50 59 55.5 54.5" fill="none" stroke="#1b1a17" stroke-width="1.6" stroke-linecap="round"/>${glasses}`;
}
const avatarSvg = (p) => `<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">${figure(p)}</svg>`;
let seed = 11;
const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const person = (i) => ({ skin: (i * 3) % 7, hair: (i * 5) % 7, style: STYLES[(i * 4 + 1) % 7], bg: (i * 2) % 7, shirt: (i * 3 + 1) % 8, glasses: i % 5 === 2 });

const $ = (id) => document.getElementById(id);

// ---------- sign-in sheet ----------
(function buildSheet() {
  const rows = 15, y0 = 230, dy = 38;
  let s = `<rect x="40" y="40" width="540" height="800" rx="22" fill="#6b4a2e"/>
    <rect x="70" y="90" width="480" height="720" rx="4" fill="#fffdf8" stroke="#1b1a17" stroke-width="1.5"/>
    <rect x="230" y="22" width="160" height="70" rx="12" fill="#9d988d" stroke="#1b1a17" stroke-width="1.5"/>
    <rect x="270" y="44" width="80" height="14" rx="7" fill="#6b675f"/>
    <text x="96" y="150" font-size="30" font-weight="700" fill="#1b1a17" letter-spacing="2">SIGN-IN SHEET</text>
    <text x="96" y="200" font-size="15" font-weight="700" fill="#6b675f" letter-spacing="2">NAME</text>
    <text x="330" y="200" font-size="15" font-weight="700" fill="#6b675f" letter-spacing="2">EMAIL</text>
    <line x1="318" y1="180" x2="318" y2="${y0 + rows * dy - 20}" stroke="#d8d2c5" stroke-width="1.5"/>`;
  for (let r = 0; r < rows; r++) s += `<line x1="90" x2="530" y1="${y0 + r * dy + 10}" y2="${y0 + r * dy + 10}" stroke="#d8d2c5" stroke-width="1.2"/>`;
  const blank = new Set([9, 12, 13, 14]);
  for (let r = 0; r < rows; r++) {
    if (blank.has(r)) continue;
    for (const [x0, w] of [[100, 150 + rnd() * 50], [332, 120 + rnd() * 70]]) {
      let d = `M${x0} ${y0 + r * dy}`, x = x0;
      while (x < x0 + w) { const a = 6 + rnd() * 10; const hgt = 6 + rnd() * 12; d += ` q${a / 2} ${-hgt} ${a} ${(rnd() - .5) * 6}`; x += a; }
      s += `<path class="scrib" data-r="${r}" d="${d}" fill="none" stroke="#2b3138" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1"/>`;
    }
  }
  s += `<circle cx="470" cy="700" r="58" fill="none" stroke="#8a5a3b" stroke-width="9" opacity=".22"/>`;
  s += `<g id="marks" opacity="0" fill="#d9502b" font-size="34" font-weight="700" font-style="italic">
    <text x="505" y="${y0 + 1 * dy + 6}">??</text><text x="505" y="${y0 + 4 * dy + 6}">??</text><text x="505" y="${y0 + 7 * dy + 6}">?</text>
    <ellipse cx="200" cy="${y0 + 10 * dy - 2}" rx="120" ry="22" fill="none" stroke="#d9502b" stroke-width="3"/></g>`;
  $('sheet').innerHTML = s;
})();
const scribs = [...document.querySelectorAll('.scrib')];

// ---------- flyers and pings ----------
const flyers = Array.from({ length: 16 }, (_, i) => {
  const el = document.createElement('div'); el.className = 'flyer';
  el.innerHTML = avatarSvg(person(i));
  $('flyers').appendChild(el);
  return { el, i, sx: 180 + (i % 8) * 70 + rnd() * 40, sy: 1150 + rnd() * 60 };
});
const pings = Array.from({ length: 8 }, (_, i) => {
  const el = document.createElement('div'); el.className = 'ping';
  el.innerHTML = `<span class="duo"><span>${avatarSvg(person(i + 3))}</span><span>${avatarSvg(person(i + 9))}</span></span>+1 connection`;
  $('pings').appendChild(el);
  return { el, i, dx: (i % 3) * 60 - 60 };
});

// ---------- helpers ----------
const clamp = (x, a = 0, b = 1) => Math.min(b, Math.max(a, x));
const lin = (t, a, b) => clamp((t - a) / (b - a));
const oc = (x) => 1 - Math.pow(1 - x, 3);
const io = (x) => x < .5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2;
const ob = (x) => { const c1 = 1.70158, c3 = c1 + 1; return 1 + c3 * Math.pow(x - 1, 3) + c1 * Math.pow(x - 1, 2); };
const E = (t, a, b, f = oc) => f(lin(t, a, b));
const win = (t, a, b, fi = .25, fo = .25) => Math.min(E(t, a, a + fi), 1 - E(t, b - fo, b, (x) => x));
const set = (el, o, tf) => { el.style.opacity = o; if (tf !== undefined) el.style.transform = tf; };
const rectOf = (el) => el.getBoundingClientRect();

function tapAt(el, t, at) {
  const k = lin(t, at - .12, at + .35);
  if (k <= 0 || k >= 1) return;
  const r = rectOf(el), tap = $('tap');
  tap.style.left = (r.left + r.width / 2) + 'px'; tap.style.top = (r.top + r.height / 2) + 'px';
  const press = t < at ? lin(t, at - .12, at) : 1;
  tap.style.opacity = t < at ? press : 1 - lin(t, at, at + .35);
  tap.style.transform = `scale(${t < at ? 1.2 - .3 * press : .9 + .6 * lin(t, at, at + .35)})`;
}

function render(t) {
  // S1 hook 0–5
  set($('s1'), win(t, 0, 5, .01, .25));
  set($('sheet'), E(t, 0, .4), `translateY(${(1 - E(t, 0, .5)) * 50}px) rotate(${-3 + E(t, 0, .6) * 1}deg)`);
  scribs.forEach((p) => { const r = +p.dataset.r; const a = .35 + r * .125; p.setAttribute('stroke-dashoffset', 1 - E(t, a, a + .3, (x) => x)); });
  $('marks').setAttribute('opacity', E(t, 2.75, 3.0));
  set($('h1a'), E(t, .25, .6), `translateY(${(1 - E(t, .25, .65)) * 26}px)`);
  set($('h1b'), E(t, 1.5, 1.85), `translateY(${(1 - E(t, 1.5, 1.9)) * 26}px)`);

  // S2 problem 5–9
  set($('s2'), win(t, 5, 9, .2, .25));
  [['pa1', 5.25], ['pa2', 6.0], ['pa3', 6.75]].forEach(([id, a]) => set($(id), E(t, a, a + .2), `translateY(${(1 - E(t, a, a + .4, ob)) * 40}px) scale(${.96 + .04 * E(t, a, a + .35)})`));

  $('band').style.transform = `scaleX(${t < 9 ? 0 : E(t, 9, 9.45, io)})`;

  // S3 reveal 9–11
  set($('s3'), win(t, 9, 11, .01, .25));
  set($('revWord'), E(t, 9.1, 9.5), `scale(${.86 + .14 * E(t, 9.1, 9.6, ob)})`);
  set($('revEyebrow'), E(t, 9.3, 9.6));
  set($('revTag'), E(t, 9.45, 9.8), `translateY(${(1 - E(t, 9.45, 9.85)) * 26}px)`);

  // S4–S6 product 11–22.5
  set($('sP'), win(t, 11, 22.5, .25, .25));
  const active = t < 14.5 ? 1 : t < 18.25 ? 2 : 3;
  [['st1', 11.15], ['st2', 14.5], ['st3', 18.25]].forEach(([id, a], i) => {
    const k = E(t, a, a + .4);
    set($(id), k * (active === i + 1 ? 1 : .28), `translateX(${(1 - k) * -30}px)`);
  });
  const bIn = E(t, 11.0, 11.6);
  set($('browser'), bIn, `translate(${800 + (1 - bIn) * 120}px, ${150 + (1 - bIn) * 40}px)`);

  // counters
  const cIn = Math.round(148 * Math.pow(lin(t, 12.25, 17.5), 1.25));
  const cConn = Math.round(212 * Math.pow(lin(t, 14.6, 17.6), 1.2));
  const cSelf = Math.round(96 * Math.pow(lin(t, 14.8, 17.6), 1.2));
  $('nIn').textContent = cIn; $('nConn').textContent = cConn; $('nSelf').textContent = cSelf;

  // highlight ring: QR panel, then stats panel
  const glow = $('glow');
  const target = t < 14.5 ? $('qrPanel') : $('statPanel');
  const gk = t < 14.5 ? win(t, 11.6, 14.5, .3, .2) : win(t, 14.5, 17.9, .3, .25);
  const gr = rectOf(target);
  glow.style.left = (gr.left - 8) + 'px'; glow.style.top = (gr.top - 8) + 'px';
  glow.style.width = (gr.width + 16) + 'px'; glow.style.height = (gr.height + 16) + 'px';
  glow.style.opacity = gk;

  // faces fly into the QR
  const q = rectOf($('posterQr'));
  const qx = q.left + q.width / 2 - 36, qy = q.top + q.height / 2 - 36;
  flyers.forEach((f) => {
    const a = 11.875 + f.i * .125, b = a + .6;
    const k = lin(t, a, b);
    if (k <= 0 || k >= 1) { f.el.style.opacity = 0; return; }
    const e = io(k);
    const x = f.sx + (qx - f.sx) * e, y = f.sy + (qy - f.sy) * e - Math.sin(Math.PI * e) * 220;
    const s = 1 - .75 * Math.pow(e, 3);
    f.el.style.opacity = k < .1 ? k * 10 : k > .85 ? (1 - k) / .15 : 1;
    f.el.style.transform = `translate(${x}px, ${y}px) scale(${s}) rotate(${(1 - e) * (f.i % 2 ? 12 : -12)}deg)`;
  });

  // connection pings rise off the stats panel
  const cr = rectOf($('connRow'));
  pings.forEach((p) => {
    const a = 14.75 + p.i * .375, k = lin(t, a, a + 1.1);
    if (k <= 0 || k >= 1) { p.el.style.opacity = 0; return; }
    const x = cr.left + cr.width * (p.i % 2 ? .52 : .3), y = cr.top + 10 - oc(k) * 110;
    p.el.style.opacity = k < .15 ? k / .15 : k > .7 ? (1 - k) / .3 : 1;
    p.el.style.transform = `translate(${x}px, ${y}px) scale(${.85 + .15 * E(t, a, a + .25, ob)})`;
  });

  // report
  set($('liveView'), 1 - E(t, 18.0, 18.2, (x) => x));
  set($('reportView'), E(t, 18.15, 18.4));
  ['rb0', 'rb1', 'rb2', 'rb3', 'rb4', 'rb5'].forEach((id, i) => {
    const a = 18.3 + i * .25;
    set($(id), E(t, a, a + .25), `translateY(${(1 - E(t, a, a + .35)) * 18}px)`);
  });
  $('tap').style.opacity = 0;
  tapAt($('reportBtn'), t, 17.95);

  // S7 outro 22.5–24.5
  set($('s7'), E(t, 22.5, 22.75));
  set($('oWord'), E(t, 22.55, 22.9), `scale(${.9 + .1 * E(t, 22.55, 23.0, ob)})`);
  set($('oEyebrow'), E(t, 22.6, 22.9));
  set($('oTag'), E(t, 22.75, 23.05), `translateY(${(1 - E(t, 22.75, 23.1)) * 24}px)`);
  set($('oBtn'), E(t, 23.0, 23.3), `scale(${.9 + .1 * E(t, 23.0, 23.35, ob)})`);
  set($('oSub'), E(t, 23.2, 23.5));
}
window.render = render;

Promise.all([document.fonts.load('700 20px "Atkinson Hyperlegible Next"'), document.fonts.load('400 20px "Atkinson Hyperlegible Next"'), document.fonts.ready,
  ...[...document.images].map((im) => im.complete ? 0 : new Promise((r) => { im.onload = im.onerror = r; }))])
  .then(() => { render(0); window.__ready = true; });
</script>
</body>
</html>
